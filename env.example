# Copy to .env: cp env.example .env

# Dev server port (use another if 3000/3025 is busy, e.g. 3010)
PORT=3025
BROWSER=none

# Linux: fixes "ENOSPC: System limit for number of file watchers reached"
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

REACT_APP_GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_USERNAME=YOUR_GITHUB_USERNAME_HERE
USE_GITHUB_DATA=false
MEDIUM_USERNAME=YOUR_MEDIUM_USERNAME_HERE

# Contact form: free access key from https://web3forms.com (sent to your email).
# Leave empty to show a plain "Email me" button instead of the form.
REACT_APP_WEB3FORMS_ACCESS_KEY=
